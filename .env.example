# Copy this file to .env and fill in your own keys, then run: chmod 600 .env
# Never commit .env to git.

# STT backend: deepgram (Flux streaming, cloud), parakeet (batch CLI, offline),
# or parakeet_stream (120M EOU streaming, offline).
STT_BACKEND=deepgram

# Deepgram (https://console.deepgram.com) — uses "Token" auth.
DEEPGRAM_API_KEY=
# Model name is configurable; Nova-3 is the v0.1 default.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
# Flux streaming model for toggle-to-talk (STT_BACKEND=deepgram).
DEEPGRAM_FLUX_MODEL=flux-general-en

# Local Parakeet batch via transcribe.cpp (only for STT_BACKEND=parakeet).
PARAKEET_BINARY=/home/prem/projects/transcribe.cpp/build/bin/transcribe-cli
PARAKEET_MODEL=/home/prem/projects/AutoType/models/parakeet-tdt-0.6b-v2-Q4_K_M.gguf

# Local Parakeet streaming via parakeet-cli (only for STT_BACKEND=parakeet_stream).
PARAKEET_STREAM_BINARY=/home/prem/projects/parakeet.cpp/parakeet-cli
PARAKEET_STREAM_MODEL=/home/prem/projects/AutoType/models/parakeet-eou-120m-q8_0.gguf

# Processing mode: raw (paste STT verbatim), clean (default cleanup),
# or smart (app-aware prompt based on the focused window).
PROCESSING_MODE=clean

# Keep a WAV copy of every utterance for debugging. Off by default.
SAVE_RECORDINGS=false

# Microphone: empty (recommended) = follow PipeWire's default source via the
# ALSA "pipewire" device, so Internal-mic <-> Bluetooth switches just work.
# Or pin a sounddevice index ("7") or name substring ("Buds", "Built-in").
# NOTE: ALSA "default" capture is broken on some Mint systems (silence) —
# leave this empty rather than writing "default".
# Bluetooth headsets must be on HSP/HFP (CVSD/mSBC) for the mic — A2DP has
# no mic. Use Settings → Microphone → Headset voice (auto).
MIC_DEVICE=

# Custom cleaning prompt: USE_CUSTOM_PROMPT=true + edit data/custom_prompt.txt
# (or use Settings → Prompt). Empty file falls back to the built-in prompt.
USE_CUSTOM_PROMPT=false

# Cleaning temperature 0.0–1.0 (lower = more literal).
CLEANING_TEMPERATURE=0.1

# Spoken prefix for voice commands ("computer cancel", "computer raw ...").
COMMAND_PREFIX=computer

# OmniRoute OpenAI-compatible endpoint — uses "Bearer" auth.
# For a local OmniRoute: http://127.0.0.1:20128
# For a remote deployment: replace with its externally reachable URL.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
