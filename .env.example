# Copy this file to .env and fill in your keys: cp .env.example .env && chmod 600 .env
# Never commit .env to git.

# ===========================================================================
# 1. LLM TEXT CLEANING PROVIDER
# ===========================================================================
# Choose any provider you want for converting raw speech into formatted,
# intelligent text. AutoType is provider-agnostic!
#
# Supported providers:
#   - openai      : OpenAI (ChatGPT)
#   - anthropic   : Anthropic (Claude via native Messages API)
#   - xai         : xAI (Grok)
#   - deepseek    : DeepSeek
#   - qwen        : Qwen (Alibaba Cloud DashScope)
#   - nvidia      : NVIDIA NIM
#   - groq        : Groq (ultra-fast Llama/Mixtral)
#   - openrouter  : OpenRouter
#   - ollama      : Ollama (100% Local LLM)
#   - custom      : Custom API Provider (e.g. OmniRoute, vLLM, LiteLLM, local server)

LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
CLEANING_TEMPERATURE=0.1

# --- Provider Reference Defaults ---
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini (or gpt-4o)
#
# Anthropic (Claude):
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-3-5-haiku-20241022 (or claude-3-5-sonnet-20241022)
#
# xAI (Grok):
#   LLM_PROVIDER=xai
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-2-mini (or grok-2)
#
# DeepSeek:
#   LLM_PROVIDER=deepseek
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# Qwen (Alibaba DashScope):
#   LLM_PROVIDER=qwen
#   LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#
# NVIDIA NIM:
#   LLM_PROVIDER=nvidia
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=meta/llama-3.3-70b-instruct
#
# Groq:
#   LLM_PROVIDER=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter:
#   LLM_PROVIDER=openrouter
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Ollama (100% Local):
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#   LLM_API_KEY=not_needed
#
# Custom Provider (e.g. OmniRoute):
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=http://127.0.0.1:20128/v1
#   LLM_MODEL=auto
#   LLM_API_KEY=your_custom_key

# (Legacy aliases: OMNIROUTE_BASE_URL, OMNIROUTE_API_KEY, OMNIROUTE_MODEL
# are still fully supported if you have an existing configuration.)


# ===========================================================================
# 2. SPEECH-TO-TEXT (STT) ENGINES: CLOUD VS LOCAL
# ===========================================================================
# Choose between Cloud STT (ultra-accurate, requires internet/API key)
# or Local STT (100% offline, runs entirely on your device with zero data leaving).
#
# Options:
#   Cloud STT : deepgram | whisper | groq | nvidia | custom_cloud
#   Local STT : parakeet_stream (real-time streaming) | parakeet (offline batch)

STT_BACKEND=deepgram

# --- Cloud STT: Deepgram (Streaming & Batch) ---
# https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
# Flux streaming model for real-time toggle-to-talk:
DEEPGRAM_FLUX_MODEL=flux-general-en

# --- Cloud STT: OpenAI Whisper / Groq / NVIDIA / Custom Cloud ---
# Standard OpenAI-compatible audio/transcriptions endpoint
CLOUD_STT_API_KEY=
CLOUD_STT_BASE_URL=https://api.openai.com/v1
CLOUD_STT_MODEL=whisper-1
CLOUD_STT_LANGUAGE=en
# Groq Whisper Cloud (fastest ~250ms batch):
#   CLOUD_STT_BASE_URL=https://api.groq.com/openai/v1
#   CLOUD_STT_MODEL=whisper-large-v3-turbo
# NVIDIA NIM Cloud ASR:
#   CLOUD_STT_BASE_URL=https://integrate.api.nvidia.com/v1
#   CLOUD_STT_MODEL=nvidia/parakeet-ctc-1.1b-asr

# --- Local STT: Parakeet (100% Offline, Zero Internet) ---
# Parakeet streaming via parakeet-cli (STT_BACKEND=parakeet_stream, 120M EOU GGUF)
PARAKEET_STREAM_BINARY=/home/prem/projects/parakeet.cpp/parakeet-cli
PARAKEET_STREAM_MODEL=/home/prem/projects/AutoType/models/parakeet-eou-120m-q8_0.gguf

# Parakeet batch via transcribe-cli (STT_BACKEND=parakeet, 0.6B GGUF)
PARAKEET_BINARY=/home/prem/projects/transcribe.cpp/build/bin/transcribe-cli
PARAKEET_MODEL=/home/prem/projects/AutoType/models/parakeet-tdt-0.6b-v2-Q4_K_M.gguf


# ===========================================================================
# 3. PROCESSING MODE & BEHAVIOR
# ===========================================================================
# Processing mode:
#   raw          : Paste STT output verbatim without LLM rewriting
#   clean        : Standard AI cleanup (removes filler words, fixes grammar)
#   smart        : Context-aware prompt adapting to the active window/app
#   professional : Formal corporate tone
#   casual       : Friendly conversational tone
#   code         : Code-style dictation preserving syntax and camelCase
PROCESSING_MODE=clean

# Save WAV audio copy of every utterance in recordings/ (useful for debugging)
SAVE_RECORDINGS=false

# Spoken prefix for in-stream voice commands ("computer cancel", "computer raw ...")
COMMAND_PREFIX=computer

# Custom cleaning prompt: USE_CUSTOM_PROMPT=true + edit data/custom_prompt.txt
USE_CUSTOM_PROMPT=false


# ===========================================================================
# 4. MICROPHONE & AUDIO HARDWARE
# ===========================================================================
# Leave empty ("") to dynamically track PipeWire's default source via ALSA
# "pipewire" (automatically switches between Internal Mic and Bluetooth Headset).
# Or specify a device index (e.g. "7") or name substring (e.g. "Buds", "Yeti").
# Note: Bluetooth headsets must use HSP/HFP (CVSD/mSBC) profile for mic input.
MIC_DEVICE=
